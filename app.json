{
  "expo": {
    "name": "Mafia Night",
    "slug": "mafia-night",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mafianight",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,

    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Mafia Night to use your microphone.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Mafia Night to access your profile photo."
        }
      ],
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication"
          }
        }
      ],
      "@config-plugins/react-native-webrtc"
    ],

    "android": {
      "package": "com.mafianight.app"
    },

    "ios": {
      "bundleIdentifier": "com.mafianight.app"
    }
  }
}
